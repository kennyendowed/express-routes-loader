{
  "compilerOptions": {
    "resolveJsonModule": true,
    "target": "esnext",
    "module": "CommonJS",
    "strict": true,
    "jsx": "preserve",
    "moduleResolution": "node",
    "declaration": true,
    "isolatedModules": true,
    // "noImplicitAny": true,
    // "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "baseUrl": ".",
    "outDir": "./dist",  // or your preferred directory
"rootDir": "./src",  
  },
   "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
