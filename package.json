{
  "name": "niggamomentrouter",
  "version": "1.1.10",
  "description": "A custom routing package for Express with TypeScript support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "npm run build && nodemon --exec babel-node --extensions .ts,.tsx src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "version": "npm version patch",
    "version:patch": "npm version patch && npm run publish:public",
    "version:minor": "npm version minor && npm run publish:public",
    "version:major": "npm version major && npm run publish:public",
    "publish:public": "npm publish --access public"
  },
  "keywords": [
    "express",
    "typescript",
    "router",
    "routing",
    "middleware",
    "netwrap",
    "node",
    "API",
    "backend",
    "RESTful",
    "niggamomentrouter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kennyendowed/express-routes-loader.git"
  },
  "bugs": {
    "url": "https://github.com/kennyendowed/express-routes-loader/issues"
  },
  "homepage": "https://github.com/kennyendowed/express-routes-loader#readme",
  "author": "kenneth akpan",
  "license": "ISC",
  "dependencies": {
    "express": "^4.21.1",
    "netwrap": "^3.0.2"
  },
  "devDependencies": {
    "@babel/node": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "nodemon": "^3.1.7",
    "typescript": "^5.6.3"
  }
}
